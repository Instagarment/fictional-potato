# ---------------------------------------------------------------------------
# Instagarment Print on Demand: settings.
# On Render these go in your service's "Environment" tab.
# For running on your own computer, copy this file to .env and fill it in.
# ---------------------------------------------------------------------------

# From dev.shopify.com → Apps → Instagarment Print on Demand → Settings → Credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# This app's public web address, e.g. https://instagarment-pod.onrender.com
APP_URL=

# Password for your print queue at APP_URL/admin (the username can be anything)
ADMIN_PASSWORD=

# Where the app keeps its small data files (store list + signing key).
# On Render this is the disk: /var/data
DATA_DIR=./data

# ---- Email alerts ---------------------------------------------------------
# Who at Instagarment gets the alerts (comma separated for several people)
ALERT_EMAIL_TO=
# Optional "from" name and address; defaults to SMTP_USER
# ALERT_EMAIL_FROM="Instagarment Print on Demand <you@gmail.com>"

# SMTP server. For Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and a
# Google "App password" (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---- Optional -------------------------------------------------------------
# APP_NAME="Instagarment Print on Demand"
# COMPANY_NAME=Instagarment
# TRACK_PRODUCT_TAG=instagarment
# ORDER_TAG_TO_PRINT=instagarment-to-print
# ORDER_TAG_PRINTED=instagarment-printed
# CATCH_UP_MINUTES=15        # double-check recent orders every N minutes (0 = off)
# SHOPIFY_API_VERSION=2026-10
# Bring your own signing key instead of letting the app create one:
# SHOPIFY_KEY_ID=
# SHOPIFY_PRIVATE_KEY_PATH=
