{
  "name": "instagarment-print-on-demand",
  "version": "1.0.0",
  "description": "Instagarment Print on Demand: a Shopify app your customers install so you're alerted when their orders include products you print.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "shopify-config": "node --env-file-if-exists=.env scripts/write-shopify-config.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^10.1.0"
  }
}
