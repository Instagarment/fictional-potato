{
  "name": "pod-print-tracker",
  "version": "1.0.0",
  "description": "Watches your Shopify orders for print-on-demand products, emails you when one needs printing, and keeps a print queue.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "register-webhook": "node --env-file-if-exists=.env scripts/register-webhook.js",
    "test-email": "node --env-file-if-exists=.env scripts/send-test-email.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^10.1.0"
  }
}
