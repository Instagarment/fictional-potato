<section class="hero{% if section.settings.full_height %} hero--tall{% endif %}">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}" class="hero__link">{%- endif -%}
  {%- if section.settings.image != blank -%}
    {%- if section.settings.image_mobile != blank -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
          sizes="100vw"
        >
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'hero__image',
            widths: '750, 1100, 1500, 1800, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </picture>
    {%- else -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'hero__image',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- endif -%}
  {%- else -%}
    <div class="hero__placeholder">
      <img src="{{ 'kate-taylor-logo.png' | asset_url }}" alt="" width="1200" height="400" loading="eager">
    </div>
  {%- endif -%}
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</section>

{% schema %}
{
  "name": "Hero image",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "A photo of Kate. Portrait photos work best on phones."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Phone image (optional)"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Fill the screen height on phones",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    }
  ],
  "presets": [{ "name": "Hero image" }]
}
{% endschema %}
