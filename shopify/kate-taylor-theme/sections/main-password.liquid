<section class="password">
  <img class="password__logo" src="{{ 'kate-taylor-logo.png' | asset_url }}" alt="{{ shop.name }}" width="1200" height="400">
  {%- if section.settings.message != blank -%}
    <p class="eyebrow">{{ section.settings.message | escape }}</p>
  {%- endif -%}
  {%- if shop.password_message != blank -%}
    <p class="password__message">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'password__signup' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p class="password__notice" role="status">{{ 'password.thanks' | t }}</p>
    {%- else -%}
      <label class="visually-hidden" for="PasswordEmail">{{ 'password.email' | t }}</label>
      <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'password.email' | t }}" required>
      <button type="submit" class="button button--accent">{{ 'password.notify' | t }}</button>
    {%- endif -%}
    {%- if form.errors -%}<p class="password__notice">{{ form.errors | default_errors }}</p>{%- endif -%}
  {%- endform -%}

  <details class="password__login">
    <summary>{{ 'password.store_owner' | t }}</summary>
    {%- form 'storefront_password' -%}
      <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
      <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
      <button type="submit" class="button button--outline">{{ 'password.enter' | t }}</button>
      {%- if form.errors -%}<p class="password__notice">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "message", "label": "Small heading", "default": "Official merch · Coming soon" }
  ]
}
{% endschema %}
