<section class="page-width section-pad">
  <h1 class="display-heading">{{ 'collections.all_collections' | t }}</h1>
  <ul class="product-grid">
    {%- for collection in collections -%}
      <li class="product-card">
        <a href="{{ collection.url }}" class="product-card__link">
          <div class="product-card__media">
            {%- if collection.featured_image -%}
              {%- assign coll_alt = collection.featured_image.alt | default: collection.title -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: alt: coll_alt, widths: '300, 400, 600, 800', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'product-card__placeholder' }}
            {%- endif -%}
          </div>
          <div class="product-card__info">
            <h2 class="product-card__title">{{ collection.title | escape }}</h2>
            <p class="product-card__meta">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{ "name": "Collections list", "class": "section-main-list-collections", "settings": [] }
{% endschema %}
