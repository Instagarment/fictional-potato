{%- comment -%}
  Prints the CSS aspect ratio for a section's "Image shape" setting.
  Accepts:
  - shape: {String} 'square', 'portrait', 'tall' or 'extra_tall'
{%- endcomment -%}
{%- case shape -%}
  {%- when 'square' -%}1 / 1
  {%- when 'tall' -%}2 / 3
  {%- when 'extra_tall' -%}1 / 2
  {%- else -%}4 / 5
{%- endcase -%}
